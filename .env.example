# Copy this file to .env and fill in real values.
# docker-compose.yml loads .env via env_file.

# Host-side port the app is published on (container always listens on 3000 internally)
APP_PORT=3000

# Supabase (public, used client-side)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Gmail SMTP, used for booking-inquiry and clinic-contact-patient emails
# GMAIL_APP_PASSWORD must be a Google App Password, not the account password
GMAIL_USER=
GMAIL_APP_PASSWORD=
